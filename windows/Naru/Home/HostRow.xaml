<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Naru.Home.HostRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    PointerCanceled="OnPointerExited">

    <Grid Padding="12,10" ColumnSpacing="16" MinHeight="56">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <FontIcon Glyph="&#xE977;" FontSize="28" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Item.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock
                Text="{x:Bind Item.Subtitle, Mode=OneWay}"
                Visibility="{x:Bind Item.SubtitleVisibility, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- The connection time gives way to the action button on hover, and to Disconnect while in session. -->
        <Grid Grid.Column="2" VerticalAlignment="Center">
            <TextBlock
                x:Name="DetailText"
                Text="{x:Bind Item.Detail, Mode=OneWay}"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressRing x:Name="Progress" Width="20" Height="20" IsActive="{x:Bind Item.Connecting, Mode=OneWay}" Visibility="Collapsed" />
            <Button x:Name="ConnectButton" Content="Connect" Visibility="Collapsed" Click="OnConnect" />
            <Button x:Name="DisconnectButton" Content="Disconnect" Visibility="Collapsed" Click="OnDisconnect" />
        </Grid>

        <Button
            x:Name="InfoButton"
            Grid.Column="3"
            Style="{StaticResource SubtleButtonStyle}"
            VerticalAlignment="Center"
            ToolTipService.ToolTip="Edit"
            Click="OnInfo">
            <FontIcon Glyph="&#xE946;" FontSize="16" />
        </Button>
    </Grid>
</UserControl>
