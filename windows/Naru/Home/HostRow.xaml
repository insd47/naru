<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Naru.Home.HostRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    PointerCanceled="OnPointerExited"
    DoubleTapped="OnDoubleTapped"
    KeyDown="OnKeyDown">

    <!-- A Settings-style card. Like a Settings card it has no selection: hover, double-click, and the keyboard act on it. -->
    <Border x:Name="Card" Style="{StaticResource Card}" Padding="16,10" MinHeight="64">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Glyph="&#xE977;" FontSize="24" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Item.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Text="{x:Bind Item.Subtitle, Mode=OneWay}"
                    Visibility="{x:Bind Item.SubtitleVisibility, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- The connection time gives way to the action button on hover, and to Disconnect while in session. -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <TextBlock
                    x:Name="DetailText"
                    Text="{x:Bind Item.Detail, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressRing x:Name="Progress" Width="20" Height="20" IsActive="{x:Bind Item.Connecting, Mode=OneWay}" Visibility="Collapsed" />
                <Button x:Name="ConnectButton" Content="Connect" Visibility="Collapsed" Click="OnConnect" />
                <Button x:Name="DisconnectButton" Content="Disconnect" Visibility="Collapsed" Click="OnDisconnect" />
            </Grid>

            <Button
                x:Name="InfoButton"
                Grid.Column="3"
                Style="{StaticResource SubtleButtonStyle}"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Edit"
                AutomationProperties.Name="Edit"
                Click="OnInfo">
                <FontIcon Glyph="&#xE946;" FontSize="16" />
            </Button>
        </Grid>
    </Border>
</UserControl>
