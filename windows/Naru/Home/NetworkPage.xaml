<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Naru.Home.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Naru.Home">

    <Page.Resources>
        <DataTemplate x:Key="RowTemplate" x:DataType="local:HostItem">
            <local:HostRow Item="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Discovery runs as long as the page is shown. -->
        <ProgressBar IsIndeterminate="True" />

        <Grid Grid.Row="1" Padding="36,20,36,16">
            <TextBlock Text="Network" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <CommandBar HorizontalAlignment="Right" Background="Transparent" DefaultLabelPosition="Collapsed" OverflowButtonVisibility="Collapsed">
                <AppBarButton Label="New Connection" ToolTipService.ToolTip="New Connection (Ctrl+N)" Click="OnAdd">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <ListView
            x:Name="List"
            Grid.Row="2"
            Padding="20,0"
            SelectionMode="Single"
            ItemTemplate="{StaticResource RowTemplate}"
            ContainerContentChanging="OnContainerContentChanging"
            DoubleTapped="OnDoubleTapped"
            KeyDown="OnKeyDown" />

        <StackPanel x:Name="Empty" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xE774;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Searching for Macs" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Macs with Screen Sharing turned on appear here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
