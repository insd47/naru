<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Naru.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
        <Style x:Key="Detail" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="36,24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="Keyboard" Style="{StaticResource Section}" />
            <StackPanel Spacing="4">
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Swap Alt and Command" />
                            <TextBlock Text="Alt sends Command and the Windows key sends Option, matching the keys on a Mac keyboard." Style="{StaticResource Detail}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="Swap" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnSwap" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sync keyboard language" />
                            <TextBlock Text="The Mac switches its input source with this computer's language. Works best with one language besides English on the Mac." Style="{StaticResource Detail}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SyncLanguage" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnSyncLanguage" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Windows key combinations" />
                            <TextBlock Text="Where shortcuts like Alt+Tab and the Windows key go, as in Remote Desktop." Style="{StaticResource Detail}" />
                        </StackPanel>
                        <ComboBox x:Name="WindowsKeys" Grid.Column="1" VerticalAlignment="Center" MinWidth="200" SelectionChanged="OnWindowsKeys">
                            <x:String>On this computer</x:String>
                            <x:String>On the Mac</x:String>
                            <x:String>Only in full screen</x:String>
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="Clipboard" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Use shared clipboard" />
                        <TextBlock Text="Text you copy on either computer can be pasted on the other." Style="{StaticResource Detail}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="Clipboard" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnClipboard" />
                </Grid>
            </Border>

            <TextBlock Text="Video" Style="{StaticResource Section}" />
            <TextBlock x:Name="Codec" Style="{StaticResource Detail}" />

            <TextBlock Text="Help" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Export diagnostics" />
                        <TextBlock Text="Saves this launch's app log as a text file to share with a bug report. It has no passwords, typed text, or clipboard contents." Style="{StaticResource Detail}" />
                    </StackPanel>
                    <Button x:Name="Export" Grid.Column="1" Content="Export" VerticalAlignment="Center" Click="OnExport" />
                </Grid>
            </Border>

            <TextBlock Text="About" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Naru" />
                    <TextBlock x:Name="Version" Style="{StaticResource Detail}" />
                    <TextBlock Style="{StaticResource Detail}" Margin="0,4,0,0">
                        <Hyperlink Click="OnNotices">Third-party notices</Hyperlink><Run Text="   " /><Hyperlink NavigateUri="https://github.com/insd47/naru/blob/main/PRIVACY.md">Privacy policy</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
