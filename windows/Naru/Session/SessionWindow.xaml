<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Naru.Session.SessionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Naru.Session">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The screen spans both rows so the title bar can overlay it in full screen. -->
        <local:ScreenGrid x:Name="Screen" Grid.Row="1" Background="Black">
            <SwapChainPanel x:Name="Surface" />
            <!-- The cursor drawn where finger touches moved it. Touch has no system pointer. -->
            <Canvas IsHitTestVisible="False">
                <Image x:Name="TouchImage" Stretch="Fill" Visibility="Collapsed" />
            </Canvas>
            <ProgressRing x:Name="Loading" IsActive="True" Width="48" Height="48" />
        </local:ScreenGrid>

        <!--
            A custom title bar rather than TitleBar, which keeps room for the caption buttons even in full screen.
            The two star columns are always equal, so the toolbar sits at the window's center. The right column ends
            with room for the caption buttons, which is zero in full screen.
        -->
        <Grid x:Name="Bar" Height="48">
            <Grid.Resources>
                <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                    <Setter Property="Width" Value="40" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Icon 16 px from the edge and the title 16 px after it, per the Windows title bar guidance -->
            <StackPanel x:Name="Heading" Orientation="Horizontal" Spacing="16" Margin="16,0,8,0" VerticalAlignment="Center">
                <Image x:Name="Icon" Width="16" Height="16" />
                <TextBlock x:Name="Caption" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel x:Name="Toolbar" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Style="{StaticResource BarButton}" ToolTipService.ToolTip="Mission Control" AutomationProperties.Name="Mission Control" Click="OnMissionControl">
                    <FontIcon Glyph="&#xE7C4;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource BarButton}" ToolTipService.ToolTip="App Windows" AutomationProperties.Name="App Windows" Click="OnAppWindows">
                    <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource BarButton}" ToolTipService.ToolTip="Desktop" AutomationProperties.Name="Desktop" Click="OnDesktop">
                    <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource BarButton}" Click="OnFullScreen" ToolTipService.ToolTip="Full Screen (Ctrl+Alt+Break)" AutomationProperties.Name="Full Screen">
                        <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Show Connections" Click="OnShowConnections">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Disconnect" Click="OnDisconnect">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8BB;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <Border x:Name="CaptionInset" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
