<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Naru.Session.SessionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The screen spans both rows so the title bar can overlay it in full screen. -->
        <Grid x:Name="Screen" Grid.Row="1" Background="Black">
            <SwapChainPanel x:Name="Surface" />
            <ProgressRing x:Name="Loading" IsActive="True" Width="48" Height="48" />
        </Grid>

        <!-- Every title bar button shares one compact size and spacing. The title bar gives buttons a minimum width, so it is cleared here. -->
        <TitleBar x:Name="Bar" Height="48">
            <TitleBar.Resources>
                <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                    <Setter Property="Width" Value="40" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </TitleBar.Resources>
            <!-- Centered on the window rather than on the space the title leaves; see CenterToolbar. -->
            <TitleBar.Content>
                <StackPanel x:Name="Toolbar" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource BarButton}" ToolTipService.ToolTip="Mission Control" AutomationProperties.Name="Mission Control" Click="OnMissionControl">
                        <FontIcon Glyph="&#xE7C4;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" ToolTipService.ToolTip="App Windows" AutomationProperties.Name="App Windows" Click="OnAppWindows">
                        <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" ToolTipService.ToolTip="Desktop" AutomationProperties.Name="Desktop" Click="OnDesktop">
                        <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                    </Button>
                </StackPanel>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,4,0" VerticalAlignment="Center">
                    <Button x:Name="FullScreenButton" Style="{StaticResource BarButton}" Click="OnFullScreen" ToolTipService.ToolTip="Full Screen (Ctrl+Alt+Break)" AutomationProperties.Name="Full Screen">
                        <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Show Connections" Click="OnShowConnections">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Disconnect" Click="OnDisconnect">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8BB;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>
    </Grid>
</Window>
