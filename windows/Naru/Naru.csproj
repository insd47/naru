<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Naru</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Naru.ico</ApplicationIcon>
    <!-- The Rust core is built for these two only. -->
    <Platforms>x64;ARM64</Platforms>
    <!-- The platform picks the architecture, and the core is built to match. Without one, the build machine's is used. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The generated bindings call the core through LibraryImport. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs is the entry point, so that a second launch can hand over to the running instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- MRT picks the scale, target size, and theme variant of each image, so every file ships. -->
  <ItemGroup>
    <Content Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Lets the single-project MSIX tooling activate before the Windows App SDK package is restored. -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- The Windows App SDK's components the app uses, rather than the whole SDK, whose AI and ML parts would ship their
         libraries in the package. Runtime is the framework package the app runs on. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <!-- Registers a debug package identity so `dotnet run` launches the packaged app. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.7.1" />
    <!-- Direct3D 11, DXGI, and Media Foundation for hardware decoding and presenting video -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <!-- XAudio2 plays audio, and FDK AAC decodes the Mac's AAC-ELD, which Windows' AAC decoder rejects. -->
    <PackageReference Include="Vortice.XAudio2" Version="3.8.3" />
    <PackageReference Include="fdk-aac" Version="2.0.3" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- FDK's license must ship in full with its binaries. -->
  <ItemGroup>
    <Content Include="$(Pkgfdk-aac)\NOTICE.txt" Link="Licenses\fdk-aac.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>

  <!-- The Rust core and its C# bindings. Both are build output and are never committed. -->
  <PropertyGroup>
    <CoreRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</CoreRoot>
    <CoreTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">aarch64-pc-windows-msvc</CoreTarget>
    <CoreTarget Condition="'$(CoreTarget)' == ''">x86_64-pc-windows-msvc</CoreTarget>
    <CoreLibrary>$(CoreRoot)target\$(CoreTarget)\release\naru.dll</CoreLibrary>
  </PropertyGroup>

  <!-- Crypto and SRTP are too slow in debug builds, so this always builds release regardless of the app's configuration. Cargo skips the work when nothing changed. -->
  <Target Name="BuildCore" BeforeTargets="BeforeBuild">
    <!-- IntermediateOutputPath is only known once targets run. No trailing slash, because `\"` would escape the quote on the command line. -->
    <PropertyGroup>
      <CoreBindings>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)uniffi</CoreBindings>
    </PropertyGroup>
    <Exec Command="cargo build -q --release --lib --target $(CoreTarget)" WorkingDirectory="$(CoreRoot)" />
  </Target>

  <!-- The bindings are generated from the metadata of the library just built. -->
  <Target Name="GenerateBindings" AfterTargets="BuildCore" Inputs="$(CoreLibrary);$(CoreRoot)uniffi.toml" Outputs="$(CoreBindings)\naru.cs">
    <RemoveDir Directories="$(CoreBindings)" />
    <Exec Command="uniffi-bindgen-cs --library &quot;$(CoreLibrary)&quot; --config &quot;$(CoreRoot)uniffi.toml&quot; --out-dir &quot;$(CoreBindings)&quot; --no-format" />
  </Target>

  <Target Name="IncludeCore" AfterTargets="GenerateBindings">
    <ItemGroup>
      <Compile Include="$(CoreBindings)\naru.cs" />
      <Content Include="$(CoreLibrary)" Link="naru_ffi.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
